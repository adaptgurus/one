apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
kind: RKE2ConfigTemplate
metadata:
  labels:
    cluster.x-k8s.io/cluster-name: <%= cluster[:uuid] %>
  name: <%= group[:uuid] %>
spec:
  template:
    spec:
      agentConfig:
        airGapped: true
      preRKE2Commands:
      - install -d /var/lib/rancher/rke2/agent/images && touch /var/lib/rancher/rke2/agent/images/.cache.json
      - |-
        set -eu
        cat <<'SHA256' | sha256sum -c -
        42983c86d1da64a92061d83afb57630cedd69241989f1b0673f3db6c3d92ee6b  /opt/install.sh
        8e12805c4bda79bec2fd20c89f705af3cb2ed11ea8854dc4937fca41b124b57a  /opt/rke2-artifacts/sha256sum-amd64.txt
        7bcbd3167d6947e1d79cdf722acdc740b28021fefb50dd5b974a1980776d4079  /opt/rke2-artifacts/rke2.linux-amd64.tar.gz
        8988a2eff587dd88b8eab86fe719703e9541a1f08d22771a94cbec446a13db86  /var/lib/rancher/rke2/agent/images/rke2-images-core.linux-amd64.tar.zst
        4359b651bfdec8f3bcc01b351b33a55ff21f06b18a767366db6f3800d5750871  /var/lib/rancher/rke2/agent/images/rke2-images-canal.linux-amd64.tar.zst
        SHA256
        test -x /usr/local/libexec/oneks/worker-disk
        systemctl is-enabled --quiet qemu-guest-agent
      - >-
        install -d /var/lib/rancher/rke2/agent/etc/kubelet.conf.d &&
        printf 'apiVersion: kubelet.config.k8s.io/v1beta1\nkind: KubeletConfiguration\nruntimeRequestTimeout: 30m\n' > /var/lib/rancher/rke2/agent/etc/kubelet.conf.d/90-layersentry-poc.conf
      - >-
        for archive in /var/lib/rancher/rke2/agent/images/*.tar.zst; do
        touch -m -d "@$(stat -c %Y "$archive")" "$archive"; done
      - >-
        vmid=$(sed -n 's/^export VMID="\([0-9][0-9]*\)"$/\1/p' /var/run/one-context/one_env | sort -u);
        case "$vmid" in ''|*[!0-9]*) exit 1;; esac;
        test -n "$vmid" &&
        install -d -m 0700 /etc/rancher/rke2/config.yaml.d &&
        printf 'kubelet-arg:\n  - provider-id=one://%s\n' "$vmid" > /etc/rancher/rke2/config.yaml.d/90-opennebula-identity.yaml
<% Array(group.dig(:disk_autoscaling, :data_disks)).each do |disk| %>
      - |-
        device=/dev/<%= disk[:target] %>
        mountpoint=<%= disk[:mount] %>
        retry=60
        while [ ! -b "$device" ] && [ "$retry" -gt 0 ]; do retry=$((retry-1)); sleep 2; done
        test -b "$device"
        install -d -m 0755 "$mountpoint"
        if ! blkid -s TYPE -o value "$device" >/dev/null 2>&1; then
          mkfs.<%= disk[:filesystem] %> -f "$device"
        fi
        uuid=$(blkid -s UUID -o value "$device")
        test -n "$uuid"
        grep -q "^UUID=$uuid " /etc/fstab || printf 'UUID=%s %s %s defaults,nofail 0 2\n' "$uuid" "$mountpoint" '<%= disk[:filesystem] %>' >> /etc/fstab
        mountpoint -q "$mountpoint" || mount "$mountpoint"
<% end %>
---
apiVersion: cluster.x-k8s.io/v1beta1
kind: MachineDeployment
metadata:
  labels:
    cluster.x-k8s.io/cluster-name: <%= cluster[:uuid] %>
  name: <%= group[:uuid] %>
spec:
  clusterName: <%= cluster[:uuid] %>
  replicas: <%= group[:user_inputs_values][:count] %>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels: {}
  template:
    spec:
      bootstrap:
        configRef:
          apiVersion: bootstrap.cluster.x-k8s.io/v1beta1
          kind: RKE2ConfigTemplate
          name: <%= group[:uuid] %>
      clusterName: <%= cluster[:uuid] %>
      infrastructureRef:
        apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
        kind: ONEMachineTemplate
        name: <%= group[:uuid] %>
      version: <%= cluster[:kubernetes_version] %>+rke2r1
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: ONEMachineTemplate
metadata:
  labels:
    cluster.x-k8s.io/cluster-name: <%= cluster[:uuid] %>
  name: <%= group[:uuid] %>
spec:
  template:
    spec:
      templateName: <%= group[:group_template_name] %>
---
apiVersion: cluster.x-k8s.io/v1beta1
kind: MachineHealthCheck
metadata:
  name: "<%= group[:uuid] %>"
spec:
  clusterName: <%= cluster[:uuid] %>
  selector:
    matchLabels:
      cluster.x-k8s.io/deployment-name: "<%= group[:uuid] %>"
  nodeStartupTimeout: 60m
  maxUnhealthy: 1
  unhealthyConditions:
  - type: Ready
    status: "False"
    timeout: 15m
  - type: Ready
    status: "Unknown"
    timeout: 15m
