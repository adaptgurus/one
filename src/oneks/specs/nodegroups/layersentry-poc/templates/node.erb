NAME = "<%= group[:group_template_name] %>"
CONTEXT = [
  BACKEND = "YES",
  NETWORK = "YES",
  GROW_FS = "/",
  SET_HOSTNAME = "$NAME",
  SSH_PUBLIC_KEY = "$USER[SSH_PUBLIC_KEY]",
  VMID = "$VMID",
  TOKEN = "YES"
]
CPU  = "<%= group[:user_inputs_values][:cpu] %>"
VCPU = "<%= group[:user_inputs_values][:vcpu] %>"
DISK = [
  IMAGE_ID = "<%= Integer(group[:user_inputs_values][:node_image_id]) %>",
  SIZE  = "<%= group[:user_inputs_values][:disk_size] %>"
]
<% Array(group.dig(:disk_autoscaling, :data_disks)).each do |disk| %>
DISK = [
  TYPE = "fs",
  SIZE = "<%= Integer(disk[:initial_gib]) * 1024 %>",
  FORMAT = "<%= disk[:filesystem] %>",
  TARGET = "<%= disk[:target] %>",
  LAYERSENTRY_DISK = "<%= disk[:name] %>"
]
<% end %>
GRAPHICS = [
  LISTEN = "127.0.0.1",
  TYPE   = "vnc"
]
HYPERVISOR = "kvm"
FEATURES = [ GUEST_AGENT = "YES" ]
LXD_SECURITY_PRIVILEGED = "true"
MEMORY     = "<%= group[:user_inputs_values][:memory] %>"
SCHED_REQUIREMENTS = "<%= cluster[:deployment][:sched_requirements] %>"
OS = [
  ARCH            = "x86_64",
  MACHINE = "q35"
]
ONEKS = [
  CLUSTER_ID   = <%= cluster[:id] %>,
  CLUSTER_NAME = "<%= cluster[:uuid] %>",
  GROUP_ID     = "<%= group[:id] %>",
  TYPE         = "<%= group[:type] %>"
]

CPU_MODEL = [ MODEL = "host-passthrough" ]
SCHED_DS_REQUIREMENTS = "ID = <%= Integer(group[:user_inputs_values][:system_datastore_id]) %>"
